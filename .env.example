# Supabase — Mumbai region project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app base URL (used inside QR payloads and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Digital signature key (Ed25519 private key, base64 raw 32 bytes) —
# generate with:  node scripts/generate-signing-key.js
GOVT_SIGNING_PRIVATE_KEY=
GOVT_SIGNING_PUBLIC_KEY=

# Scheduled expiry-reminder cron — protects /api/cron/reminders.
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Optional email delivery for reminders (Resend). If unset, reminders are
# in-app only. RESEND_FROM must be a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM="MAAPSETU <noreply@your-domain>"
